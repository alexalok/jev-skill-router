{
  "description": "Rank skills on the initial task and restore the list after compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/router.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading Skill Router"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/router.mjs\"",
            "timeout": 130,
            "statusMessage": "Checking skill routing"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/router.mjs\"",
            "timeout": 20,
            "statusMessage": "Passing skills to subagent"
          }
        ]
      }
    ]
  }
}
